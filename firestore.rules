rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CROWDCARE GUARDIAN TACTICAL RULES v3.1
     * Explicitly authorizes all authenticated users (including Guests) 
     * for full tactical operations: reading registry, listing alerts, and receiving broadcasts.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    // Explicit permissions for tactical collections to prevent 'list' errors
    match /children/{childId} {
      allow read, write: if isSignedIn();
    }

    match /rescueEvents/{eventId} {
      allow read, write: if isSignedIn();
      match /notificationLogs/{logId} {
        allow read, write: if isSignedIn();
      }
    }

    match /broadcasts/{broadcastId} {
      allow read, write: if isSignedIn();
    }

    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    match /roles_admin/{userId} {
      allow read, write: if isSignedIn();
    }

    match /roles_operator/{userId} {
      allow read, write: if isSignedIn();
    }

    // Global Fallback for recursive operations
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}