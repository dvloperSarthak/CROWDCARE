rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Universal tactical authorization for all authenticated nodes.
    // This resolves 'list' and 'get' permission issues for active operations.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Explicit collection access to ensure list operations are permitted
    match /rescueEvents/{alertId} {
      allow list, get, create, update: if request.auth != null;
    }
    
    match /children/{childId} {
      allow list, get, create, update: if request.auth != null;
    }
    
    match /broadcasts/{broadcastId} {
      allow list, get, create: if request.auth != null;
    }
  }
}