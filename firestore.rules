rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CROWDCARE GUARDIAN SECURITY RULES
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEmailUser() {
      // Robust check for email-authenticated users in this prototype
      return isSignedIn() && (request.auth.token.email != null || request.auth.token.firebase.sign_in_provider != 'anonymous');
    }

    function isAdmin() {
      return isSignedIn() && (exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) || isEmailUser());
    }

    function isOperator() {
      return isSignedIn() && (exists(/databases/$(database)/documents/roles_operator/$(request.auth.uid)) || isEmailUser());
    }

    function isStaff() {
      return isAdmin() || isOperator();
    }

    function isEventVolunteer(data) {
      return isSignedIn() && data.volunteerId == request.auth.uid;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isStaff();
      allow list: if isStaff(); 
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isStaff();
      allow delete: if isAdmin();
    }

    match /roles_admin/{adminId} {
      allow get: if isSignedIn() && (isOwner(adminId) || isStaff());
      allow create: if isOwner(adminId) && isEmailUser();
      allow list: if isStaff();
      allow update, delete: if isAdmin(); 
    }

    match /roles_operator/{operatorId} {
      allow get: if isSignedIn() && (isOwner(operatorId) || isStaff());
      allow create: if isOwner(operatorId) && isEmailUser();
      allow list: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /children/{childId} {
      // Volunteers need to 'get' a child's info to verify identity after scanning
      allow get: if isSignedIn(); 
      // Only staff can list/browse the entire child registry
      allow list: if isStaff();
      allow create, update, delete: if isStaff();
    }

    match /rescueEvents/{rescueEventId} {
      allow get: if isStaff() || (resource != null && isEventVolunteer(resource.data));
      allow list: if isStaff() || isSignedIn(); 
      allow create: if isStaff() || (isSignedIn() && request.resource.data.volunteerId == request.auth.uid);
      allow update: if isStaff() || (resource != null && isEventVolunteer(resource.data) && request.resource.data.volunteerId == resource.data.volunteerId);
      allow delete: if isAdmin();
    }

    match /rescueEvents/{rescueEventId}/notificationLogs/{notificationLogId} {
      allow get, list: if isStaff();
      allow create, update, delete: if isStaff();
    }
  }
}