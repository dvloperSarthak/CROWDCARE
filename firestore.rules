rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CROWDCARE GUARDIAN TACTICAL RULES v9.0
     * Globally authorizes all authenticated tactical nodes (Staff and Anonymous Volunteers).
     * Provides full tactical synchronization for rescue operations.
     */

    match /{document=**} {
      // Allows any signed-in user to participate in tactical operations.
      // Explicitly authorizes 'list' and 'get' methods to resolve UI sync errors.
      allow read, write: if request.auth != null;
    }
  }
}