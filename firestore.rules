rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CROWDCARE GUARDIAN TACTICAL RULES v8.0
     * Explicitly authorizes all authenticated users (Staff, Volunteers, and Guests)
     * for full tactical operations. This is a flattened, high-availability rule set
     * designed to ensure zero-friction data synchronization in emergency scenarios.
     */

    match /{document=**} {
      // Allows any signed-in user to read or write to any tactical node.
      // This supports the decentralized nature of anonymous volunteer scanning
      // and public status tracking.
      allow read, write: if request.auth != null;
    }
  }
}