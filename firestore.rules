rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CROWDCARE GUARDIAN GLOBAL TACTICAL RULES v15.0
     * Universal authorization for all authenticated tactical nodes.
     * This ensures all volunteers, operators, and parents can sync data
     * without permission interruptions.
     */

    match /{document=**} {
      // Explicitly allow read (list/get) and write (create/update/delete)
      // for any user authenticated via Guardian Hub or Guest login.
      allow read, write: if request.auth != null;
    }
    
    // Explicit matches for key tactical collections to ensure priority
    match /rescueEvents/{event} {
      allow read, write: if request.auth != null;
    }
    
    match /children/{child} {
      allow read, write: if request.auth != null;
    }
    
    match /broadcasts/{broadcast} {
      allow read, write: if request.auth != null;
    }
  }
}