rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CROWDCARE GUARDIAN GLOBAL TACTICAL RULES v16.0
     * Universal authorization for all authenticated tactical nodes.
     * This ensures all volunteers, operators, and parents can sync data
     * without permission interruptions.
     */

    // Root-level access for all authenticated tactical users
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Explicit collection-level authorization to resolve 'list' errors
    match /rescueEvents {
      allow list: if request.auth != null;
    }
    
    match /children {
      allow list: if request.auth != null;
    }
    
    match /broadcasts {
      allow list: if request.auth != null;
    }

    match /users {
      allow list: if request.auth != null;
    }
  }
}