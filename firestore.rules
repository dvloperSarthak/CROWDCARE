rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CROWDCARE GUARDIAN TACTICAL RULES v12.0
     * Granular authorization for tactical nodes.
     * Ensures 'list' and 'get' operations are explicitly permitted for all authenticated users.
     */

    match /rescueEvents/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /children/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /broadcasts/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /users/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /roles_admin/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /roles_operator/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Default catch-all for any other authenticated synchronization
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}