rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CROWDCARE GUARDIAN SECURITY RULES
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isOperator() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_operator/$(request.auth.uid));
    }

    function isStaff() {
      return isAdmin() || isOperator();
    }

    function isEventVolunteer(data) {
      return isSignedIn() && data.volunteerId == request.auth.uid;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; 
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    match /roles_admin/{adminId} {
      // PROTOTYPE FIX: Allow users to create their own admin record if they are logged in via email
      allow get: if isSignedIn() && (isOwner(adminId) || isStaff());
      allow create: if isOwner(adminId) && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow list: if isStaff();
      allow update, delete: if isAdmin(); 
    }

    match /roles_operator/{operatorId} {
      allow get: if isSignedIn() && (isOwner(operatorId) || isStaff());
      allow create: if isOwner(operatorId) && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow list: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /children/{childId} {
      allow get, list: if isStaff();
      allow create, update, delete: if isStaff();
    }

    match /rescueEvents/{rescueEventId} {
      allow get: if isStaff() || (resource != null && isEventVolunteer(resource.data));
      allow list: if isStaff() || isSignedIn(); 
      allow create: if isStaff() || (isSignedIn() && request.resource.data.volunteerId == request.auth.uid);
      allow update: if isStaff() || (resource != null && isEventVolunteer(resource.data) && request.resource.data.volunteerId == resource.data.volunteerId);
      allow delete: if isAdmin();
    }

    match /rescueEvents/{rescueEventId}/notificationLogs/{notificationLogId} {
      allow get, list: if isStaff();
      allow create, update, delete: if isStaff();
    }
  }
}