rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * CROWDCARE GUARDIAN GLOBAL TACTICAL AUTHORIZATION
     * Explicitly authorizes all tactical nodes (Volunteers, Operators, Parents)
     * to sync and list mission-critical data when authenticated.
     */
    
    // Authorization for all authenticated users to participate in rescue operations
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    
    match /children/{childId} {
      allow read, write: if request.auth != null;
    }
    
    match /rescueEvents/{eventId} {
      allow read, write: if request.auth != null;
    }
    
    match /broadcasts/{broadcastId} {
      allow read, write: if request.auth != null;
    }
    
    match /roles_admin/{adminId} {
      allow read, write: if request.auth != null;
    }
    
    match /roles_operator/{operatorId} {
      allow read, write: if request.auth != null;
    }
    
    // Global fallback for tactical collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}