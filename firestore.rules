rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CROWDCARE GUARDIAN TACTICAL RULES v10.0
     * Globally authorizes all authenticated tactical nodes (Staff and Anonymous Volunteers).
     * Provides full tactical synchronization for rescue operations across all collections.
     */

    match /{document=**} {
      // Allows any signed-in user (Email or Anonymous) to participate in tactical operations.
      // Explicitly authorizes all read (get/list) and write (create/update/delete) operations.
      allow read, write: if request.auth != null;
    }
  }
}