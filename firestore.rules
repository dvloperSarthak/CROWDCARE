rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CROWDCARE GUARDIAN TACTICAL RULES
     * Prototype v3.0 - Global Access for Signed-in Personnel
     * This configuration authorizes all authenticated users (including Guests) 
     * for full read/write operations on tactical collections.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    // Global Match: Ensures all signed-in users can participate in rescue ops
    match /{document=**} {
      allow read, write: if isSignedIn();
    }

    // Specific match for nested subcollections if any
    match /rescueEvents/{rescueEventId}/notificationLogs/{notificationLogId} {
      allow read, write: if isSignedIn();
    }
  }
}