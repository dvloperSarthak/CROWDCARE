rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CROWDCARE GUARDIAN TACTICAL RULES v5.0
     * Globally authorizes all authenticated users (Staff, Volunteers, and Guests)
     * for full tactical operations across all collections.
     * This ensures that any person acting as a volunteer or parent can access
     * real-time safety data without permission interruptions.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    // Explicit permissions for all tactical collections to resolve 'list' and 'get' errors
    match /children/{childId} {
      allow read, write: if isSignedIn();
    }

    match /rescueEvents/{eventId} {
      allow read, write: if isSignedIn();
      match /notificationLogs/{logId} {
        allow read, write: if isSignedIn();
      }
    }

    match /broadcasts/{broadcastId} {
      allow read, write: if isSignedIn();
    }

    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    match /roles_admin/{userId} {
      allow read, write: if isSignedIn();
    }

    match /roles_operator/{userId} {
      allow read, write: if isSignedIn();
    }

    // Global Fallback for recursive operations and nested structures
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}