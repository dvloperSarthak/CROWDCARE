rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * CROWDCARE GUARDIAN GLOBAL TACTICAL RULES
     * Universal authorization for all authenticated tactical nodes.
     * Ensures Volunteers, Operators, and Parents can sync data without interruption.
     */
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}