rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CROWDCARE GUARDIAN SECURITY RULES
     * Version 2.8.0 - Resolved List/Get Permission Conflicts
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEmailUser() {
      return isSignedIn() && (request.auth.token.email != null || request.auth.token.firebase.sign_in_provider == 'password');
    }

    function isAdmin() {
      return isSignedIn() && (exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) || isEmailUser());
    }

    function isOperator() {
      return isSignedIn() && (exists(/databases/$(database)/documents/roles_operator/$(request.auth.uid)) || isEmailUser());
    }

    function isStaff() {
      return isAdmin() || isOperator();
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isStaff();
      allow list: if isStaff(); 
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isStaff();
      allow delete: if isAdmin();
    }

    match /roles_admin/{adminId} {
      allow get: if isSignedIn() && (isOwner(adminId) || isStaff());
      allow create: if isOwner(adminId) && isEmailUser();
      allow list: if isStaff();
      allow update, delete: if isAdmin(); 
    }

    match /roles_operator/{operatorId} {
      allow get: if isSignedIn() && (isOwner(operatorId) || isStaff());
      allow create: if isOwner(operatorId) && isEmailUser();
      allow list: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /children/{childId} {
      // Explicitly allow list and get for scanning and AI search
      allow list, get: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    match /rescueEvents/{rescueEventId} {
      // Explicitly allow list and get for volunteers and command center
      allow list, get: if isSignedIn();
      // Allow creation by any authenticated volunteer
      allow create: if isSignedIn();
      // Allow updates for status changes or notes by volunteers and staff
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /rescueEvents/{rescueEventId}/notificationLogs/{notificationLogId} {
      allow read, write: if isStaff();
    }

    match /broadcasts/{broadcastId} {
      // Explicitly allow list and get for tactical updates
      allow list, get: if isSignedIn();
      allow write: if isStaff();
    }
  }
}