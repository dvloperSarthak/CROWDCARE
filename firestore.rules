rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CROWDCARE GUARDIAN GLOBAL TACTICAL RULES v17.0
     * Universal authorization for all authenticated tactical nodes.
     * This ensures all volunteers, operators, and parents can sync data
     * without permission interruptions.
     */

    // Root-level recursive wildcard for all authenticated users
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Explicit collection-level matches to ensure list/get consistency
    match /rescueEvents/{eventId} {
      allow read, write: if request.auth != null;
    }
    
    match /children/{childId} {
      allow read, write: if request.auth != null;
    }
    
    match /broadcasts/{broadcastId} {
      allow read, write: if request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}