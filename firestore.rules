
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Universal access for authenticated tactical nodes
    // This allows list, get, create, and update operations for all authenticated users
    
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    
    match /children/{childId} {
      allow read, write, list: if request.auth != null;
    }
    
    match /rescueEvents/{eventId} {
      allow read, write, list: if request.auth != null;
    }
    
    match /broadcasts/{broadcastId} {
      allow read, write, list: if request.auth != null;
    }
    
    match /roles_admin/{adminId} {
      allow read, write: if request.auth != null;
    }
    
    match /roles_operator/{operatorId} {
      allow read, write: if request.auth != null;
    }
    
    // Global recursive allow for nested tactical collections
    match /{document=**} {
      allow read, write, list: if request.auth != null;
    }
  }
}
